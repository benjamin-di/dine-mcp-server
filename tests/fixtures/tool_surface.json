  "description": "One venue in full: channels, each provider's booking rules (how many days ahead,\nparty size limits, card or deposit), experiences or courses, booking links, opening hours\nand sources. Costs one provider request per channel when not cached.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "venue_id": {
     "description": "A venue_id from dine_find_venue",
     "maxLength": 40,
     "minLength": 3,
     "type": "string"
    }
   },
   "required": [
    "venue_id"
   ],
   "type": "object"
  },
  "name": "dine_get_venue",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "channels": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Channels",
     "type": "array"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "venue_id": {
     "title": "Venue Id",
     "type": "string"
    }
   },
   "required": [
    "venue_id",
    "name",
    "channels"
   ],
   "title": "VenueOutput",
   "type": "object"
  },
  "title": "Get venue"
 },
 {
  "_meta": {
   "fastmcp": {
    "tags": []
   }
  },
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": true
  },
  "description": "Table availability for venues over dates, a time window and a party size. One result per\nvenue and channel: {venue_id, venue_name, channel, status, time_zone, slots [{start, kind,\narea, experience, price, requires_card, booking_link}], coverage {dates_checked,\ndates_not_checked}, observed_at, served_from, booking_link, opens_at, min_party, max_party, contact,\nnote}. status: ok, none_available, not_yet_open (see opens_at), party_too_small, party_too_large, closed,\ncontact_only, not_connected, blocked, rate_limited, unavailable, unsupported, unknown_venue,\nskipped_deadline. Large requests are refused with too_broad: narrow them.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "date_from": {
     "description": "First date, YYYY-MM-DD, venue local",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "date_to": {
     "anyOf": [
      {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Last date inclusive (default date_from); at most 7 days"
    },
    "kinds": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "bookable",
         "request",
         "waitlist"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Slot kinds to include (default bookable and request)"
    },
    "party_size": {
     "default": 2,
     "description": "Number of diners",
     "maximum": 20,
     "minimum": 1,
     "type": "integer"
    },
    "response_format": {
     "default": "concise",
     "description": "concise: up to 6 slots per venue and day",
     "enum": [
      "concise",
      "detailed"
     ],
     "type": "string"
    },
    "time_from": {
     "default": "17:00",
     "description": "Earliest time, HH:MM venue local",
     "pattern": "^\\d{2}:\\d{2}$",
     "type": "string"
    },
    "time_to": {
     "default": "22:30",
     "description": "Latest time, HH:MM; earlier than time_from crosses midnight",
     "pattern": "^\\d{2}:\\d{2}$",
     "type": "string"
    },
    "venue_ids": {
     "description": "1-5 venue_ids from dine_find_venue",
     "items": {
      "maxLength": 40,
      "minLength": 3,
      "type": "string"
     },
     "maxItems": 5,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "venue_ids",
    "date_from"
   ],
   "type": "object"
  },
  "name": "dine_check_availability",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "query": {
     "additionalProperties": true,
     "title": "Query",
     "type": "object"
    },
    "results": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Results",
     "type": "array"
    },
    "summary": {
     "additionalProperties": true,
     "title": "Summary",
     "type": "object"
    }
   },
   "required": [
    "query",
    "results",
    "summary"
   ],
   "title": "AvailabilityOutput",
   "type": "object"
  },
  "title": "Check availability"
 },
