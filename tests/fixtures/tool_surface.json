  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "check": {
     "default": false,
     "description": "Run budgeted provider canaries (15-minute cooldown)",
     "type": "boolean"
    }
   },
   "type": "object"
  },
  "name": "dine_status",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "providers": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Providers",
     "type": "array"
    },
    "version": {
     "title": "Version",
     "type": "string"
    }
   },
   "required": [
    "version",
    "providers"
   ],
   "title": "StatusOutput",
   "type": "object"
  },
  "title": "Status"
 }
